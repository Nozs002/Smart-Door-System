# Required local Docker configuration. Copy this file to .env and replace all
# placeholder secrets. Do not commit .env.

# MySQL
MYSQL_DATABASE=smart_door
MYSQL_USER=smart_door
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me

# Backend JWT: all three values are required when starting with Docker Compose.
JWT_SECRET=replace_with_a_long_random_secret
JWT_ISSUER=smart-door-local
JWT_AUDIENCE=smart-door-mobile

# MQTT credentials used by Backend
MQTT_USERNAME=smart_door
MQTT_PASSWORD=change_me

# Browser origins allowed by Backend CORS; separate multiple origins with commas.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Optional overrides; Compose supplies the shown defaults when omitted.
SPRING_PROFILES_ACTIVE=local
JWT_ACCESS_TOKEN_TTL=15m
MQTT_CONNECTION_TIMEOUT=10s
